{
  "manifest_version": 3,
  "name": "CanvasCapture",
  "short_name": "CanvasCapture",
  "description": "Save every canvas on the page, including WebGL, as PNG images",
  "version": "1.2",
  "minimum_chrome_version": "119",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Capture canvas!"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["scripting", "activeTab", "downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
